			copyright information, and complete status, please see Annex A of the ACAL v1.0 JSONPath Profile Version 1.0 specification, which contains the License, Document
			Status and Notices. </xs:documentation>
	</xs:annotation>

	<xs:import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="https://www.w3.org/2001/xml.xsd"/>
	<xs:import namespace="urn:oasis:names:tc:xacml:4.0:core:schema"
		schemaLocation="acal-core-xml-v4.0-schema.xsd" />

	<!-- Adding support for JSONPath (RFC 9535) in AttributeSelector -->
	<xs:element name="JSONPathAttributeSelector" type="JSONPathAttributeSelectorType" substitutionGroup="xacml:AttributeSelector" />
	<xs:complexType name="JSONPathAttributeSelectorType">
		<xs:complexContent>
			<xs:extension base="xacml:AttributeSelectorType">
				<!-- JSONPath-specific parameter(s) -->
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="JSONPathEntityAttributeSelector" type="JSONPathEntityAttributeSelectorType" substitutionGroup="xacml:EntityAttributeSelector" />
	<xs:complexType name="JSONPathEntityAttributeSelectorType">
		<xs:complexContent>
			<xs:extension base="xacml:EntityAttributeSelectorType">
				<!-- JSONPath-specific parameter(s) -->
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
